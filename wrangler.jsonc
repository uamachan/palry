{
  // Cloudflare Workers の Static Assets 配信用設定。
  // worker.js は dist/ の静的ファイルを env.ASSETS から返すだけの入口。
  "name": "palry",
  "compatibility_date": "2026-06-10",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  }
}
