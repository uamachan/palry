{
  // Cloudflare Pages/Workers の静的アセット配信用設定。
  // Pairly は現在、フロントエンドを Cloudflare で配信し、
  // Firebase Auth + Firestore をデータ保存/認可の中心として使う構成です。
  // Express の /api サーバーはこの設定では起動しません。
  "name": "palry",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
