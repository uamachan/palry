# Cloudflare Pages / Workers Static Assets 用の本番環境変数例
# Render / Express API 前提の値は使わない。

# Firebase Web config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# サイトの公開URL（sitemap生成やメタ情報用）
SITE_URL=https://your-domain.example

# アナリティクス（任意）
VITE_GA_ID=

# エラーモニタリング（任意）
VITE_SENTRY_DSN=

# 現在のCloudflare + Firestore直利用構成では不要。
# 古いExpress API構成へ戻す場合だけ使う。
VITE_API_BASE_URL=
