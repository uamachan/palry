NODE_ENV=production
PORT=3001

# データ保存ディレクトリ。本番では必ず永続ディスク/ボリュームのパスを指定する。
# Render の場合は Persistent Disk を作り、Mount Path を /data にしておく。
# 未設定時も本番では /data を使うが、確実に保存するため DATA_DIR を明示する。
DATA_DIR=/data

# PostgreSQL migration target. 現時点のAPI runtimeはJSON保存のままですが、
# npm run db:migrate / npm run db:import-json でこのDBへ移行できます。
DATABASE_URL=

# JSONファイル保存のロック設定（複数プロセス競合と stale lock 回収用）
JSON_LOCK_TIMEOUT_MS=10000
JSON_LOCK_STALE_MS=30000
JSON_LOCK_RETRY_MS=25

# フロントの公開URL。CORS許可に使う。
# 例: https://palry.onrender.com
CLIENT_ORIGIN=https://your-frontend-domain.example

# フロントとAPIを別サービスに分ける場合、フロント側ビルド時に設定する。
# 同じRender Web ServiceでExpressがdistを配信する場合は空でOK。
# 例: https://your-api-domain.onrender.com
VITE_API_BASE_URL=

# レート制限（任意。未設定なら既定値が使われる）
# 全API: 1分あたりIPごとの上限 / 認証系(register,login): 1分あたりIPごとの上限
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_REPORT_PER_MIN=10
RATE_LIMIT_DM_PER_MIN=30
MAX_REPORTS_PER_DAY=20
REPORT_AUTO_HIDE_THRESHOLD=3
MAX_AUDIT_EVENTS=5000
MAX_REPORTS_STORED=10000
MAX_MESSAGES_STORED=50000
DM_THREAD_MESSAGE_LIMIT=100
DM_THREADS_LIMIT=100
RECEIVED_LIKES_LIMIT=200
ADMIN_REPORTS_LIMIT=200

# 管理者メール。未設定なら管理APIは全拒否。
ADMIN_EMAILS=

# 管理者メール（カンマ区切り）。未設定なら誰も管理者でない（管理APIは全拒否）。
ADMIN_EMAILS=

# 通報の悪用対策しきい値（任意）
# 1アカウントの1日あたり通報上限 / 自動非表示に必要な異なる通報者数
MAX_REPORTS_PER_DAY=20
REPORT_AUTO_HIDE_THRESHOLD=3

# サイトの公開URL（sitemap生成に使用。未設定なら https://palry.onrender.com）
SITE_URL=https://palry.onrender.com

# アナリティクス（任意）。設定すると同意後に GA4 を読み込み、CSP も自動許可する。
VITE_GA_ID=

# エラーモニタリング（任意）。Sentry を使う場合に設定。
# 併せて index.html に Sentry ローダ(CDN)を追加し、下記 CSP_*_EXTRA に Sentry ドメインを足す。
VITE_SENTRY_DSN=

# CSP に追加で許可するドメイン（スペース区切り、任意）。
# 例: CSP_SCRIPT_SRC_EXTRA=https://browser.sentry-cdn.com
#     CSP_CONNECT_SRC_EXTRA=https://*.ingest.sentry.io
CSP_SCRIPT_SRC_EXTRA=
CSP_CONNECT_SRC_EXTRA=

# デモ課金を本番で有効化する場合のみ true（既定はフェイルクローズで決済停止）
ENABLE_DEMO_PURCHASE=

# 実決済（Stripe）統合用（任意）。設定すると server/lib/payments.js が有効化対象になる。
# 併せて `npm i stripe` と Webhook 設定が必要（README/payments.js 参照）。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 検証済みFirebaseトークンのキャッシュ保持時間(ms)。既定 5分。
TOKEN_CACHE_TTL_MS=300000

# リクエストボディ上限（画像/音声をbase64で受けるため大きめ）
JSON_BODY_LIMIT=8mb

# Firebase Web config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-side Firebase Identity Toolkit lookup uses this key.
# Usually the same value as VITE_FIREBASE_API_KEY.
FIREBASE_WEB_API_KEY=

# Firebase Admin SDK を使ったサーバー側IDトークン検証。
# FIREBASE_SERVICE_ACCOUNT_JSON または FIREBASE_SERVICE_ACCOUNT_BASE64 のどちらかを設定すると、
# REST lookup より先に Admin SDK で検証します。未設定時は FIREBASE_WEB_API_KEY にフォールバックします。
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_CHECK_REVOKED_TOKENS=false
