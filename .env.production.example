NODE_ENV=production
PORT=3001

# データ保存ディレクトリ。本番では必ず永続ディスク/ボリュームのパスを指定する。
# （未設定だと再デプロイでデータが消える環境がある）
DATA_DIR=/data

# Production public URL. Use comma-separated values only when you intentionally allow multiple origins.
CLIENT_ORIGIN=https://your-domain.example

# レート制限（任意。未設定なら既定値が使われる）
# 全API: 1分あたりIPごとの上限 / 認証系(register,login): 1分あたりIPごとの上限
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=20

# 検証済みFirebaseトークンのキャッシュ保持時間(ms)。既定 5分。
TOKEN_CACHE_TTL_MS=300000

# リクエストボディ上限（画像/音声をbase64で受けるため大きめ）
JSON_BODY_LIMIT=8mb

# Firebase Web config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-side Firebase Identity Toolkit lookup uses this key.
# Usually the same value as VITE_FIREBASE_API_KEY.
FIREBASE_WEB_API_KEY=
