rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isParticipant(participants) {
      return signedIn() && participants is list && request.auth.uid in participants;
    }

    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function hasOnlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function allowedStorageUrl(value) {
      return value == ''
        || value.matches('https://firebasestorage.googleapis.com/.*')
        || value.matches('https://storage.googleapis.com/.*');
    }

    function profileMediaPathFor(uid, value) {
      return value == '' || value.matches('profileMedia/' + uid + '/.*');
    }

    // 入力サイズ・型の最低限チェック（任意フィールドは存在する場合のみ検証）。
    // TODO(storage-migration): profilePhoto/voiceIntro のインライン保存を廃止し、
    // Firebase Storage の profileMedia/{uid}/... へ完全移行する。
    function profileFieldsValid(uid, data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 80))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('riotId' in data) || (data.riotId is string && data.riotId.size() <= 80))
        && (!('xHandle' in data) || (data.xHandle is string && data.xHandle.size() <= 80))
        && (!('region' in data) || (data.region is string && data.region.size() <= 80))
        && (!('rank' in data) || (data.rank is string && data.rank.size() <= 80))
        && (!('role' in data) || (data.role is string && data.role.size() <= 80))
        && (!('gender' in data) || (data.gender is string && data.gender.size() <= 40))
        && (!('ageRange' in data) || (data.ageRange is string && data.ageRange.size() <= 40))
        && (!('vc' in data) || (data.vc is string && data.vc.size() <= 80))
        && (!('favoriteWeapon' in data) || (data.favoriteWeapon is string && data.favoriteWeapon.size() <= 80))
        && (!('profilePhotoUrl' in data) || (data.profilePhotoUrl is string && data.profilePhotoUrl.size() <= 1000 && allowedStorageUrl(data.profilePhotoUrl)))
        && (!('voiceIntroUrl' in data) || (data.voiceIntroUrl is string && data.voiceIntroUrl.size() <= 1000 && allowedStorageUrl(data.voiceIntroUrl)))
        && (!('profilePhotoPath' in data) || (data.profilePhotoPath is string && data.profilePhotoPath.size() <= 300 && profileMediaPathFor(uid, data.profilePhotoPath)))
        && (!('voiceIntroPath' in data) || (data.voiceIntroPath is string && data.voiceIntroPath.size() <= 300 && profileMediaPathFor(uid, data.voiceIntroPath)))
        // タグ: intentTags 許可リストのみ、最大 4 件
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 4
          && data.tags.hasOnly(['気軽に遊ぶ友達', 'ランクガチ', '恋人探し', 'まずはデュオ', '固定相方',
                                 'VCで話したい', '聞き専OK', '初心者歓迎', '夜メイン', '休日メイン'])))
        // エージェント: 公式エージェントのみ、最大 6 件
        && (!('agents' in data) || (data.agents is list && data.agents.size() <= 6
          && data.agents.hasOnly(['Astra', 'Breach', 'Brimstone', 'Chamber', 'Clove', 'Cypher',
                                   'Deadlock', 'Fade', 'Gekko', 'Harbor', 'Iso', 'Jett',
                                   'KAY/O', 'Killjoy', 'Miks', 'Neon', 'Omen', 'Phoenix',
                                   'Raze', 'Reyna', 'Sage', 'Skye', 'Sova', 'Tejo',
                                   'Veto', 'Viper', 'Vyse', 'Waylay', 'Yoru'])))
        // マップ: 公式マップのみ、最大 5 件
        && (!('maps' in data) || (data.maps is list && data.maps.size() <= 5
          && data.maps.hasOnly(['アセント', 'スプリット', 'ヘイヴン', 'バインド',
                                 'アイスボックス', 'ブリーズ', 'フラクチャー', 'パール',
                                 'ロータス', 'サンセット', 'アビス', 'カロード'])));
    }

    function validProfileCreate(uid) {
      return isSelf(uid)
        && hasOnlyKeys([
          'id', 'name', 'riotId', 'ageRange', 'age', 'gender', 'region',
          'profilePhotoUrl', 'profilePhotoPath', 'rank', 'role',
          'tags', 'agents', 'xHandle', 'bio', 'voiceIntroUrl',
          'voiceIntroPath', 'vc', 'maps', 'favoriteWeapon', 'plan', 'verified',
          'agreedAt', 'createdAt', 'updatedAt'
        ])
        && profileFieldsValid(uid, request.resource.data)
        && request.resource.data.id == uid
        && request.auth.token.email_verified == true
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'FREE')
        && (!('verified' in request.resource.data) || request.resource.data.verified == true)
        && (!('autoHidden' in request.resource.data));
    }

    function validProfileUpdate(uid) {
      return isSelf(uid)
        && hasOnlyKeys([
          'id', 'name', 'riotId', 'ageRange', 'age', 'gender', 'region',
          'profilePhotoUrl', 'profilePhotoPath', 'rank', 'role',
          'tags', 'agents', 'xHandle', 'bio', 'voiceIntroUrl',
          'voiceIntroPath', 'vc', 'maps', 'favoriteWeapon', 'plan', 'verified',
          'agreedAt', 'createdAt', 'updatedAt'
        ])
        && profileFieldsValid(uid, request.resource.data)
        && request.resource.data.id == uid
        && request.resource.data.plan == resource.data.plan
        && (!('verified' in request.resource.data) || request.resource.data.verified == resource.data.verified)
        && (!('autoHidden' in request.resource.data));
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if validProfileCreate(uid);
      allow update: if validProfileUpdate(uid);
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.auth.token.email_verified == true
        && hasOnlyKeys(['id', 'name', 'ageRange', 'age', 'gender', 'region',
                        'profilePhotoUrl', 'profilePhotoPath', 'rank', 'role', 'tags', 'agents',
                        'bio', 'voiceIntroUrl', 'voiceIntroPath', 'vc', 'maps',
                        'favoriteWeapon', 'verified', 'createdAt', 'updatedAt'])
        && profileFieldsValid(uid, request.resource.data)
        && request.resource.data.id == uid
        && (!('verified' in request.resource.data) ||
            !exists(/databases/$(database)/documents/users/$(uid)) ||
            request.resource.data.verified == get(/databases/$(database)/documents/users/$(uid)).data.verified);
      allow update: if isSelf(uid)
        && hasOnlyKeys(['id', 'name', 'ageRange', 'age', 'gender', 'region',
                        'profilePhotoUrl', 'profilePhotoPath', 'rank', 'role', 'tags', 'agents',
                        'bio', 'voiceIntroUrl', 'voiceIntroPath', 'vc', 'maps',
                        'favoriteWeapon', 'verified', 'createdAt', 'updatedAt'])
        && profileFieldsValid(uid, request.resource.data)
        && request.resource.data.id == uid
        && (!('verified' in request.resource.data) ||
            !exists(/databases/$(database)/documents/users/$(uid)) ||
            request.resource.data.verified == get(/databases/$(database)/documents/users/$(uid)).data.verified);
      allow delete: if false;
    }

    match /likes/{likeId} {
      allow read: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /receivedLikes/{receivedLikeId} {
      allow read: if signedIn() && (
        resource.data.forUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.forUid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status'])
        && request.resource.data.status == 'blocked';
    }

    match /matches/{matchId} {
      allow read: if isParticipant(resource.data.participants);
      allow create, update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if signedIn() && exists(/databases/$(database)/documents/matches/$(resource.data.matchId))
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.participants;
      // DM作成・既読更新は Callable Functions が Admin SDK で行う。
      // createdAt/readAt/unreadCount をクライアント任せにしない。
      allow create, update, delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && (
        resource.data.byUid == request.auth.uid ||
        resource.data.targetUid == request.auth.uid
      );
      allow create, update: if signedIn()
        && blockId == request.auth.uid + '_block_' + request.resource.data.targetUid
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && hasOnlyKeys(['byUid', 'targetUid', 'createdAt']);
      allow delete: if false;
    }

    match /footprints/{footprintId} {
      allow read: if signedIn() && resource.data.profileId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
