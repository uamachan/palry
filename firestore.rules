rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isParticipant(participants) {
      return signedIn() && participants is list && request.auth.uid in participants;
    }

    function hasOnlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    // 入力サイズ・型の最低限チェック（任意フィールドは存在する場合のみ検証）。
    // 巨大ペイロード（profilePhoto/voiceIntro のデータURL）やリストの肥大化を防ぐ。
    function profileFieldsValid(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 80))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('riotId' in data) || (data.riotId is string && data.riotId.size() <= 80))
        && (!('xHandle' in data) || (data.xHandle is string && data.xHandle.size() <= 80))
        && (!('region' in data) || (data.region is string && data.region.size() <= 80))
        && (!('rank' in data) || (data.rank is string && data.rank.size() <= 80))
        && (!('role' in data) || (data.role is string && data.role.size() <= 80))
        && (!('gender' in data) || (data.gender is string && data.gender.size() <= 40))
        && (!('ageRange' in data) || (data.ageRange is string && data.ageRange.size() <= 40))
        && (!('vc' in data) || (data.vc is string && data.vc.size() <= 80))
        && (!('favoriteWeapon' in data) || (data.favoriteWeapon is string && data.favoriteWeapon.size() <= 80))
        && (!('profilePhoto' in data) || (data.profilePhoto is string && data.profilePhoto.size() <= 1500000))
        && (!('voiceIntro' in data) || (data.voiceIntro is string && data.voiceIntro.size() <= 1500000))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 30))
        && (!('agents' in data) || (data.agents is list && data.agents.size() <= 30))
        && (!('maps' in data) || (data.maps is list && data.maps.size() <= 30));
    }

    // 公開 users 文書（全ログインユーザーが読める）には email などの個人情報を置かない。
    // メールアドレスは Firebase Auth が保持しており、候補表示にも不要なため保存しない。
    function validProfileCreate(uid) {
      return isSelf(uid)
        && hasOnlyKeys([
          'id', 'name', 'riotId', 'ageRange', 'age', 'gender', 'region',
          'profilePhoto', 'rank', 'role', 'tags', 'agents', 'xHandle', 'bio',
          'voiceIntro', 'vc', 'maps', 'favoriteWeapon', 'plan', 'verified',
          'agreedAt', 'createdAt', 'updatedAt'
        ])
        && profileFieldsValid(request.resource.data)
        && request.resource.data.id == uid
        // メール確認済みユーザーのみプロフィール作成を許可（未認証アカウント対策）。
        // verified はクライアント任せにせず、email_verified と矛盾させない。
        && request.auth.token.email_verified == true
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'FREE')
        && (!('verified' in request.resource.data) || request.resource.data.verified == true)
        && (!('autoHidden' in request.resource.data));
    }

    function validProfileUpdate(uid) {
      return isSelf(uid)
        && hasOnlyKeys([
          'id', 'name', 'riotId', 'ageRange', 'age', 'gender', 'region',
          'profilePhoto', 'rank', 'role', 'tags', 'agents', 'xHandle', 'bio',
          'voiceIntro', 'vc', 'maps', 'favoriteWeapon', 'plan', 'verified',
          'agreedAt', 'createdAt', 'updatedAt'
        ])
        && profileFieldsValid(request.resource.data)
        && request.resource.data.id == uid
        && request.resource.data.plan == resource.data.plan
        && (!('verified' in request.resource.data) || request.resource.data.verified == resource.data.verified)
        && (!('autoHidden' in request.resource.data));
    }

    function validMatchId(matchId, participants) {
      return participants.size() == 2
        && participants[0] != participants[1]
        && (
          matchId == participants[0] + '_match_' + participants[1] ||
          matchId == participants[1] + '_match_' + participants[0]
        );
    }

    // 双方向の like 文書が揃っている（=相互いいね）ことを必須にする。
    // これが無いと、任意のログインユーザーが被害者とのマッチ文書を偽造して
    // 同意なしに DM を送りつけられる。like 文書IDは `${fromUid}_${toUid}` 形式。
    function mutualLikeExists(participants) {
      return exists(/databases/$(database)/documents/likes/$(participants[0] + '_' + participants[1]))
        && exists(/databases/$(database)/documents/likes/$(participants[1] + '_' + participants[0]));
    }

    match /users/{uid} {
      // 候補一覧表示のためログイン済みユーザーはプロフィールを読める。
      allow read: if signedIn();
      allow create: if validProfileCreate(uid);
      allow update: if validProfileUpdate(uid);
      allow delete: if false;
    }

    match /likes/{likeId} {
      allow read: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create, update: if signedIn()
        && likeId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.type in ['like', 'super', 'dual']
        && hasOnlyKeys(['fromUid', 'toUid', 'type', 'createdAt']);
      allow delete: if false;
    }

    match /receivedLikes/{receivedLikeId} {
      allow read: if signedIn() && (
        resource.data.forUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      // 偽装防止: fromProfileName/Photo などクライアント任意のプロフィール値は保存させない。
      // 表示側は fromUid から users プロフィールを取得して名前/写真を出す。
      allow create: if signedIn()
        && receivedLikeId == request.resource.data.forUid + '_from_' + request.auth.uid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.forUid is string
        && request.resource.data.forUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['like', 'super', 'dual']
        && hasOnlyKeys(['forUid', 'fromUid', 'type', 'status', 'createdAt']);
      allow update: if signedIn()
        && resource.data.forUid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'blocked'];
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isParticipant(resource.data.participants);
      allow create, update: if isParticipant(request.resource.data.participants)
        && validMatchId(matchId, request.resource.data.participants)
        && mutualLikeExists(request.resource.data.participants)
        && hasOnlyKeys(['id', 'participants', 'createdAt'])
        && request.resource.data.id == matchId;
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if signedIn() && exists(/databases/$(database)/documents/matches/$(resource.data.matchId))
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.participants;
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId))
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.participants
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 500
        && hasOnlyKeys(['matchId', 'senderUid', 'body', 'createdAt', 'readAt']);
      allow update: if signedIn()
        && exists(/databases/$(database)/documents/matches/$(resource.data.matchId))
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.participants
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['readAt']);
      allow delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && (
        resource.data.byUid == request.auth.uid ||
        resource.data.targetUid == request.auth.uid
      );
      allow create, update: if signedIn()
        && blockId == request.auth.uid + '_block_' + request.resource.data.targetUid
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && hasOnlyKeys(['byUid', 'targetUid', 'createdAt']);
      allow delete: if false;
    }

    match /footprints/{footprintId} {
      allow read: if signedIn() && resource.data.actorUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.profileId is string
        && hasOnlyKeys(['actorUid', 'profileId', 'name', 'rank', 'gender', 'action', 'createdAt']);
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if signedIn() && resource.data.reporterUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.profileId is string
        && request.resource.data.profileId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200
        && request.resource.data.status == 'open'
        && hasOnlyKeys(['reporterUid', 'profileId', 'reason', 'status', 'createdAt']);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
