{
  "name": "palry",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Palry - VALORANT teammate matching service",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "local": "vite --host localhost --open /",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "test": "node --test",
    "test:rules": "node --test rules-tests/firestore-rules.mjs",
    "release:check": "npm run build && node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "firebase": "^12.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.20.0"
  }
}
