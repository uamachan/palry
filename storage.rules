rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return verifiedUser() && request.auth.uid == uid;
    }

    function allowedProfileMediaType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        || request.resource.contentType.matches('audio/(mpeg|mp4|webm|wav)');
    }

    match /profileMedia/{uid}/{fileName} {
      allow read: if verifiedUser();
      allow write: if isSelf(uid)
        && request.resource != null
        && request.resource.size <= 5242880
        && allowedProfileMediaType();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
